# Required
SECRET_KEY=your-secret-key-here

# Optional: Google OAuth (for v2 login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI Image Generation provider
# Set FLUX_API_URL to enable real generation (unset = dev placeholder fallback).
FLUX_API_URL=
FLUX_API_KEY=
# FLUX_GENERATE_PATH=/v1/generate
# FLUX_STATUS_PATH=/v1/status/{id}
# FLUX_IMAGE_PATH=/v1/image/{id}
# FLUX_TIMEOUT=60
# FLUX_POLL_INTERVAL=2

# Railway sets PORT automatically — no need to set it
